<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.tom.progress.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>progress</string>
			</array>
		</dict>
	</array>
	<key>AI_PROXY_URL</key>
	<string>$(AI_PROXY_URL)</string>
	<key>OPENAI_API_KEY</key>
	<string>$(OPENAI_API_KEY)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSHealthShareUsageDescription</key>
	<string>Progress reads your step count from Apple Health to show daily progress toward your step goal.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Progress does not write workouts, nutrition, or other data to Apple Health. It only reads your step count.</string>
</dict>
</plist>
