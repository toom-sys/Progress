# This file contains the fastlane configuration
# For more information about the format, see: https://docs.fastlane.tools/advanced/#control-configuration-by-lane-and-by-platform
#
# Configuration for the Progress iOS App

default_platform(:ios)

platform :ios do
  # Constants
  SCHEME = "Progress"
  PROJECT = "Progress.xcodeproj"
  BUNDLE_ID = "com.tom.progress"
  TEAM_ID = ENV.fetch("APPLE_TEAM_ID", "Z2942J63UA")
  
  before_all do
    setup_ci if ENV["CI"]
  end

  # MARK: - Beta Lane
  desc "Build and upload to TestFlight"
  lane :beta do
    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
    key_content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]
    if key_id.to_s.empty? || issuer_id.to_s.empty? || key_content.to_s.empty?
      UI.user_error!(
        "Missing App Store Connect API credentials. Add GitHub secrets " \
        "APP_STORE_CONNECT_API_KEY_ID, APP_STORE_CONNECT_ISSUER_ID, and " \
        "APP_STORE_CONNECT_API_KEY_CONTENT, then re-run the TestFlight workflow."
      )
    end

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: !key_content.include?("BEGIN PRIVATE KEY"),
      duration: 1200,
      in_house: false
    )

    begin
      produce(
        api_key: api_key,
        app_identifier: BUNDLE_ID,
        app_name: "Progress",
        language: "English",
        sku: "progress-ios",
        team_id: TEAM_ID
      )
    rescue StandardError => exception
      UI.important("App Store Connect app already exists or could not be created: #{exception.message}")
    end

    unless ENV["CI"]
      ensure_git_status_clean(show_uncommitted_changes: true)
    end

    UI.message "🔐 Injecting secrets into configuration files..."
    sh("../Scripts/inject-secrets.sh inject")

    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      initial_build_number: 0
    ) + 1
    increment_build_number(
      xcodeproj: PROJECT,
      build_number: build_number
    )

    if ENV["MATCH_GIT_URL"].to_s.empty?
      cert(api_key: api_key, team_id: TEAM_ID)
      sigh(api_key: api_key, app_identifier: BUNDLE_ID, team_id: TEAM_ID)
      profile_name = lane_context[SharedValues::SIGH_NAME]
    else
      match(
        type: "appstore",
        readonly: true,
        app_identifier: BUNDLE_ID,
        git_url: ENV["MATCH_GIT_URL"],
        team_id: TEAM_ID,
        api_key: api_key
      )
      profile_name = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][BUNDLE_ID]
    end

    update_code_signing_settings(
      use_automatic_signing: false,
      path: PROJECT,
      team_id: TEAM_ID,
      targets: ["Progress"],
      bundle_identifier: BUNDLE_ID,
      profile_name: profile_name,
      code_sign_identity: "Apple Distribution"
    )

    build_app(
      scheme: SCHEME,
      configuration: "Release",
      sdk: "iphoneos",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      clean: true,
      include_symbols: true,
      xcargs: "CODE_SIGN_ENTITLEMENTS=Progress/Progress-iOS.entitlements",
      export_options: {
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: {
          BUNDLE_ID => profile_name
        }
      }
    )

    changelog = "Latest Progress build"
    begin
      changelog = sh("git log -1 --pretty=%s", log: false).strip
    rescue StandardError
      UI.important("Using the default TestFlight changelog")
    end

    upload_to_testflight(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      skip_waiting_for_build_processing: true,
      notify_external_testers: false,
      distribute_external: false,
      changelog: changelog
    )

    UI.message "🧹 Cleaning up configuration files..."
    sh("../Scripts/inject-secrets.sh restore")
    clean_build_artifacts
  end

  # MARK: - Lint Lane
  desc "Run SwiftLint and unit tests"
  lane :lint do
    UI.header "🧪 Running Progress iOS Lint & Test Suite"
    
    # Inject secrets for testing (using test/development values)
    UI.message "🔐 Injecting secrets for testing..."
    sh("../Scripts/inject-secrets.sh inject")
    
    # Run SwiftLint
    UI.message "🔍 Running SwiftLint analysis..."
    swiftlint(
      mode: :lint,
      config_file: ".swiftlint.yml",
      reporter: "json",
      output_file: "swiftlint-results.json",
      raise_if_swiftlint_error: true
    )
    
    # Run unit tests
    UI.message "🧪 Running unit tests..."
    run_tests(
      scheme: SCHEME,
      devices: ["iPhone 15 Pro"],
      code_coverage: true,
      output_types: "junit,html",
      output_files: "test-results.xml,test-results.html",
      fail_build: true,
      skip_slack: true
    )
    
    # Run design token checks
    UI.message "🎨 Checking design token compliance..."
    sh("../Scripts/ci/check-design-tokens.sh")
    
    # Run localization checks
    UI.message "🌍 Checking localization compliance..."
    sh("../Scripts/ci/check-localization.sh")
    
    # Generate coverage report if xcov is available
    if sh("which xcov", error_callback: ->(result) { false })
      UI.message "📊 Generating code coverage report..."
      xcov(
        scheme: SCHEME,
        minimum_coverage_percentage: 80.0,
        include_test_targets: false,
        output_directory: "coverage_reports"
      )
    else
      UI.important "⚠️ xcov not found. Install with: gem install xcov"
    end
    
    # Check for TODO/FIXME comments
    UI.message "📝 Checking for TODO/FIXME comments..."
    todos = sh("grep -r -E 'TODO|FIXME|HACK' ../Progress/ --include='*.swift' || true")
    unless todos.strip.empty?
      todo_count = todos.lines.count
      UI.important "⚠️ Found #{todo_count} TODO/FIXME comments. Consider addressing these before release."
    end
    
    # Restore original configuration files
    UI.message "🔄 Restoring original configuration files..."
    sh("../Scripts/inject-secrets.sh restore")
    
    UI.success "✅ All lint checks and tests passed!"
  end

  # MARK: - Helper Lanes
  desc "Setup certificates and provisioning profiles"
  lane :certificates do
    match(
      type: "development",
      app_identifier: BUNDLE_ID,
      force_for_new_devices: true
    )
    match(
      type: "appstore",
      app_identifier: BUNDLE_ID
    )
  end
  
  desc "Refresh provisioning profiles"
  lane :refresh_profiles do
    match(
      type: "development",
      app_identifier: BUNDLE_ID,
      force: true
    )
    match(
      type: "appstore",
      app_identifier: BUNDLE_ID,
      force: true
    )
  end
  
  desc "Clean and reset"
  lane :clean do
    clear_derived_data
    clean_build_artifacts
    reset_git_repo(force: true, skip_clean: true)
    
    # Clean up any remaining configuration backups
    sh("../Scripts/inject-secrets.sh cleanup")
  end

  desc "Inject configuration secrets"
  lane :inject_secrets do
    UI.message "🔐 Injecting secrets into configuration files..."
    sh("../Scripts/inject-secrets.sh inject")
    UI.success "✅ Secrets injected successfully"
  end

  desc "Restore configuration files"
  lane :restore_configs do
    UI.message "🔄 Restoring original configuration files..."
    sh("../Scripts/inject-secrets.sh restore")
    UI.success "✅ Configuration files restored"
  end

  # MARK: - Error Handling
  error do |lane, exception|
    UI.error "❌ Lane #{lane} failed with exception: #{exception}"
    
    # Always restore configuration files on error
    begin
      sh("../Scripts/inject-secrets.sh restore")
    rescue
      UI.important "⚠️ Could not restore configuration files"
    end
    
    # Clean up on error
    clean_build_artifacts
    
    # Send error notification
    notification(
      title: "Progress iOS - Build Failed",
      subtitle: "Lane: #{lane}",
      message: exception.message
    )
  end
  
  after_all do |lane|
    UI.success "🎉 Lane #{lane} completed successfully!"
  end
end 