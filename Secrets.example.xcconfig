// Copy this file to Secrets.xcconfig (same directory) and fill in real values.
// Secrets.xcconfig is gitignored — never commit real keys.

// Server-side AI proxy (preferred — the OpenAI key stays on the server).
// Note the $() which stops xcconfig treating // as a comment.
// Leave empty to fall back to calling OpenAI directly with OPENAI_API_KEY.
AI_PROXY_URL = https:/$()/europe-west2-your-project.cloudfunctions.net/aiProxy

// Direct OpenAI access for local development (used only when AI_PROXY_URL is empty).
OPENAI_API_KEY = sk-proj-your-key-here
