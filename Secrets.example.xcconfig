// Copy this file to Secrets.xcconfig (same directory) and fill in real values.
// Secrets.xcconfig is gitignored — never commit real keys.
//
// Release builds ignore this file's AI_PROXY_URL and always use the
// production proxy in Release.xcconfig. Debug builds use the URL in
// Config.xcconfig unless you override it here.

// Uncomment to point a Debug build at a different proxy.
// The $() stops xcconfig from treating // as a comment.
// AI_PROXY_URL = https:/$()/europe-west2-progress-d601c.cloudfunctions.net/aiProxy

// Direct OpenAI access for local Debug builds, used only when AI_PROXY_URL
// is empty. Release builds never call OpenAI directly.
// OPENAI_API_KEY = sk-proj-your-key-here
